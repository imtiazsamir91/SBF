@model EBS.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Admin Control Center</h2>
            <p class="text-muted mb-0">System overview, statistics, and booking management.</p>
        </div>
        <div>
            <span class="badge bg-dark p-2"><i class="fas fa-user-shield me-1"></i> @User.Identity?.Name</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white border-0 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-1">Total Users</div>
                            <div class="h3 mb-0 fw-bold">@Model.TotalUsers</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-white-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white border-0 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-1">Total Sellers</div>
                            <div class="h3 mb-0 fw-bold">@Model.TotalSellers</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-tie fa-2x text-white-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark border-0 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-1">Categories</div>
                            <div class="h3 mb-0 fw-bold">@Model.TotalCategories</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-th-list fa-2x text-dark-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white border-0 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs fw-bold text-uppercase mb-1">Total Bookings</div>
                            <div class="h3 mb-0 fw-bold">@Model.TotalBookings</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-ticket-alt fa-2x text-white-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Booking Management Table Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold text-dark"><i class="fas fa-list-alt me-2 text-primary"></i> All System Bookings & Lock Management</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th>Service Item</th>
                            <th>Travel Date</th>
                            <th>Status</th>
                            <th>Amount</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBookings != null && Model.RecentBookings.Any())
                        {
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td class="fw-bold">#@booking.BookingId</td>
                                    <td>@booking.CustomerName</td>
                                    <td>@booking.ItemName</td>
                                    <td>@booking.TravelDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="badge @(booking.Status == "CONFIRMED" ? "bg-success" : booking.Status == "LOCKED" ? "bg-warning text-dark" : "bg-secondary")">
                                            @booking.Status
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success">৳@booking.TotalAmount</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                <input type="hidden" name="status" value="CONFIRMED" />
                                                <button type="submit" class="btn btn-sm btn-outline-success" @(booking.Status == "CONFIRMED" ? "disabled" : "")>
                                                    <i class="fas fa-check"></i> Confirm
                                                </button>
                                            </form>

                                            <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                <input type="hidden" name="status" value="REJECTED" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" @(booking.Status == "REJECTED" ? "disabled" : "")>
                                                    <i class="fas fa-times"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No booking records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
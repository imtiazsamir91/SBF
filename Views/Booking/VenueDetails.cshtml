@model EBS.Models.PostItem
@{
    ViewData["Title"] = "Venue Details & Booking Request";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- VENUE INFO & SEAT BREAKDOWN (FIXED BY SELLER) -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h3 class="fw-bold text-dark mb-2">@Model.Title</h3>
                <p class="text-muted"><i class="fas fa-user-tie text-success me-1"></i> Managed by <strong>@Model.AuthorName</strong></p>
                <p class="text-secondary"><i class="fas fa-map-marker-alt text-danger me-1"></i> @Model.Location</p>

                <hr />

                <h5 class="fw-bold text-dark mb-3"><i class="fas> <i class="fas fa-layer-group text-success me-2"></i> Fixed Seat Breakdown & Rates</h5>
                <div class="table-responsive">
                    <table class="table table-bordered bg-light rounded-3 align-middle">
                        <thead class="table-secondary">
                            <tr>
                                <th>Category</th>
                                <th>Fixed Seats</th>
                                <th>Rate per Seat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Categories != null && Model.Categories.Count > 0)
                            {
                                foreach (var cat in Model.Categories)
                                {
                                    <tr>
                                        <td class="fw-semibold">@cat.CategoryName</td>
                                        <td><span class="badge bg-primary">@cat.TotalSeats Seats</span></td>
                                        <td class="text-success fw-bold">৳@cat.PricePerSeat</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- BOOKING REQUEST FORM CARD -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-paper-plane text-success me-2"></i> Send Booking Request</h5>

                <form asp-controller="Booking" asp-action="RequestBooking" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="itemId" value="@Model.PostId" />

                    <!-- EVENT DATE -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Event Date</label>
                        <input type="date" name="travelOrEventDate" class="form-control rounded-pill px-3 py-2" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- EVENT TIME (FROM - TO) -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Start Time</label>
                            <input type="time" name="startTime" class="form-control rounded-pill px-3 py-2" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">End Time</label>
                            <input type="time" name="endTime" class="form-control rounded-pill px-3 py-2" required />
                        </div>
                    </div>

                    <!-- PURPOSE / DESCRIPTION BOX -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Event Purpose / Description</label>
                        <textarea name="eventPurpose" class="form-control rounded-3 p-3" rows="3" placeholder="Write what purpose you are booking this venue for (e.g. Wedding Reception, Birthday)..." required></textarea>
                    </div>

                    <!-- FOOD / CATERING CHECKBOX OPTIONS (SELLER MANAGED) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-success"><i class="fas fa-utensils me-1"></i> Select Catering / Food Add-ons</label>
                        <div class="p-3 bg-light rounded-3 border">
                            <!-- ডেমো ফুড আইটেম (পরে সেলার টেবিল থেকে লুপ করে আনতে পারবেন) -->
                            <div class="form-check mb-2">
                                <input class="form-check-input food-checkbox" type="checkbox" name="selectedFoods" value="Chicken Biryani (৳350/plate)" data-price="350" id="food1">
                                <label class="form-check-label small fw-semibold" for="food1">Chicken Biryani (৳350 / plate)</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input food-checkbox" type="checkbox" name="selectedFoods" value="Mutton Tehari (৳450/plate)" data-price="450" id="food2">
                                <label class="form-check-label small fw-semibold" for="food2">Mutton Tehari (৳450 / plate)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input food-checkbox" type="checkbox" name="selectedFoods" value="Soft Drinks & Water (৳50/person)" data-price="50" id="food3">
                                <label class="form-check-label small fw-semibold" for="food3">Soft Drinks & Water (৳50 / person)</label>
                            </div>
                        </div>
                    </div>

                    <!-- CALCULATION DISPLAY -->
                    <div class="alert alert-light border small rounded-3 mb-3 p-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Venue Total (Fixed):</span>
                            <span class="fw-semibold" id="venueSubtotal">৳0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Food Add-ons Total:</span>
                            <span class="fw-semibold" id="foodSubtotal">৳0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">VAT (15%):</span>
                            <span class="fw-semibold" id="vatDisplay">৳0.00</span>
                        </div>
                        <hr class="my-1" />
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold text-dark">Total Estimated Amount:</span>
                            <span class="fw-bold text-success fs-6" id="finalTotalDisplay">৳0.00</span>
                        </div>
                    </div>

                    <!-- HIDDEN TOTAL AMOUNT FIELD -->
                    <input type="hidden" id="totalAmountInput" name="totalAmount" required />

                    <div class="alert alert-info small rounded-3 mb-3">
                        <i class="fas fa-info-circle me-1"></i> Once approved by the seller, you will have <strong>2 hours</strong> to complete payment.
                    </div>

                    <button type="submit" class="btn btn-success w-100 rounded-pill py-2.5 fw-semibold shadow-sm">
                        <i class="fas fa-paper-plane me-1"></i> Send Request to Seller
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // সেলারের দেওয়া ফিক্সড সিট ও রেটের মোট হিসাব
            let venueBaseTotal = 0;
            @if (Model.Categories != null)
            {
                    foreach (var cat in Model.Categories)
                    {
                            <text>venueBaseTotal += @cat.TotalSeats * @cat.PricePerSeat;</text>
                    }
            }

            const foodCheckboxes = document.querySelectorAll('.food-checkbox');
            const venueSubtotalEl = document.getElementById('venueSubtotal');
            const foodSubtotalEl = document.getElementById('foodSubtotal');
            const vatDisplayEl = document.getElementById('vatDisplay');
            const finalTotalDisplayEl = document.getElementById('finalTotalDisplay');
            const totalAmountInput = document.getElementById('totalAmountInput');

            function calculateTotals() {
                let foodTotal = 0;
                foodCheckboxes.forEach(cb => {
                    if (cb.checked) {
                        foodTotal += parseFloat(cb.getAttribute('data-price')) || 0;
                    }
                });

                let subtotal = venueBaseTotal + foodTotal;
                let vat = subtotal * 0.15; // 15% VAT
                let grandTotal = subtotal + vat;

                venueSubtotalEl.textContent = '৳' + venueBaseTotal.toFixed(2);
                foodSubtotalEl.textContent = '৳' + foodTotal.toFixed(2);
                vatDisplayEl.textContent = '৳' + vat.toFixed(2);
                finalTotalDisplayEl.textContent = '৳' + grandTotal.toFixed(2);
                totalAmountInput.value = grandTotal.toFixed(2);
            }

            foodCheckboxes.forEach(cb => {
                cb.addEventListener('change', calculateTotals);
            });

            // Initial calculation on load
            calculateTotals();
        });
    </script>
}
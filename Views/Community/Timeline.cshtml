@model EBS.Models.CommunityFeedViewModel
@{
    ViewData["Title"] = "Customer Timeline & Venues";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid py-2">
    <!-- SEARCH AND STAR RATING FILTER BAR -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <form method="get" asp-action="Timeline" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted">Search Venue / Seller</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3 rounded-start-pill"><i class="fas fa-search"></i></span>
                    <input type="text" name="searchString" class="form-control bg-light border-start-0 rounded-end-pill py-2" placeholder="e.g. Sultan Convention Hall..." value="@Context.Request.Query["searchString"]" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Location Filter</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3 rounded-start-pill"><i class="fas fa-map-marker-alt text-danger"></i></span>
                    <input type="text" name="locationFilter" class="form-control bg-light border-start-0 rounded-end-pill py-2" placeholder="e.g. Dhaka, Demra..." value="@Context.Request.Query["locationFilter"]" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Star Rating Filter</label>
                <select name="starFilter" class="form-select bg-light rounded-pill py-2">
                    <option value="">All Ratings</option>
                    <option value="5" selected="@(Context.Request.Query["starFilter"] == "5")">⭐⭐⭐⭐⭐ (5 Star)</option>
                    <option value="4" selected="@(Context.Request.Query["starFilter"] == "4")">⭐⭐⭐⭐ (4 Star)</option>
                    <option value="3" selected="@(Context.Request.Query["starFilter"] == "3")">⭐⭐⭐ (3 Star)</option>
                    <option value="2" selected="@(Context.Request.Query["starFilter"] == "2")">⭐⭐ (2 Star)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-success w-100 rounded-pill py-2 fw-semibold shadow-sm">
                    <i class="fas fa-filter me-1"></i> Filter
                </button>
            </div>
        </form>
    </div>

    <!-- SUCCESS & ERROR MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark m-0"><i class="fas fa-th-large text-success me-2"></i> Available Verified Venues</h4>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-warning rounded-pill px-3 shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#createPostModal">
                <i class="fas fa-plus-circle me-1"></i> Post Requirement
            </button>
            <span class="badge bg-white text-secondary shadow-sm px-3 py-2 rounded-pill fw-semibold border">
                Total Found: <strong>@(Model.Posts != null ? Model.Posts.Count : 0)</strong>
            </span>
        </div>
    </div>

    <!-- VENUE CARDS -->
    <div class="row g-4">
        @if (Model.Posts != null && Model.Posts.Count > 0)
        {
            foreach (var post in Model.Posts)
            {
                int stars = Convert.ToInt32(post.Price ?? 3); // 5, 4, 3, 2

                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white d-flex flex-column">
                        <div class="card-body p-4 flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">@post.Title</h5>
                                    <p class="text-muted small mb-0"><i class="fas fa-user-tie text-success me-1"></i> Managed by <strong>@post.AuthorName</strong></p>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill fw-semibold small">Verified</span>
                            </div>

                            <!-- DYNAMIC GOLDEN STARS RENDER -->
                            <div class="mb-3">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= stars)
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-muted opacity-50"></i>
                                    }
                                }
                                <span class="small text-muted ms-1 fw-semibold">(@stars Star)</span>
                            </div>

                            <p class="text-secondary small mb-3"><i class="fas fa-map-marker-alt text-danger me-1"></i> @post.Location</p>
                            <p class="text-secondary small mb-3 lh-base">@post.Description</p>

                            <div class="d-flex gap-2 mb-3">
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small">
                                    <i class="fas fa-chair text-primary me-1"></i> Max Capacity: <strong>@post.Capacity</strong> Seats
                                </span>
                            </div>

                            <!-- SEAT CATEGORY & PRICING TABLE -->
                            @if (post.Categories != null && post.Categories.Count > 0)
                            {
                                <div class="bg-light p-3 rounded-3 mt-3 border">
                                    <h6 class="fw-bold text-dark mb-2 small"><i class="fas fa-layer-group text-success me-1"></i> Seat Category & Rate Breakdown</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-borderless bg-transparent mb-0 small">
                                            <thead>
                                                <tr class="text-muted border-bottom">
                                                    <th class="pb-2">Category</th>
                                                    <th class="pb-2">Seats</th>
                                                    <th class="text-end pb-2">Price / Seat</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var cat in post.Categories)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold text-dark">@cat.CategoryName</td>
                                                        <td>@cat.TotalSeats</td>
                                                        <td class="text-success fw-bold text-end">৳@cat.PricePerSeat</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-white border-0 p-4 pt-0 d-flex justify-content-between align-items-center">
                            <small class="text-muted fw-semibold"><i class="far fa-clock me-1"></i> Instant Booking</small>
                            <!-- UPDATED BOOK VENUE BUTTON TO TRIGGER CONFIRMATION MODAL -->
                            <button type="button" 
                                    class="btn btn-success btn-sm rounded-pill px-4 fw-semibold shadow-sm"
                                    data-bs-toggle="modal" 
                                    data-bs-target="#bookingModal"
                                    data-itemid="@post.PostId"
                                    data-venuename="@post.Title">
                                <i class="fas fa-ticket-alt me-1"></i> Book Venue
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
                    <i class="fas fa-star-half-alt fa-3x text-muted mb-3 opacity-50"></i>
                    <h5 class="text-muted fw-semibold">No venues found matching your star rating filter.</h5>
                    <a asp-action="Timeline" class="btn btn-outline-success btn-sm rounded-pill px-4 mt-2">Reset Filters</a>
                </div>
            </div>
        }
    </div>
</div>

<!-- 1. BOOKING CONFIRMATION MODAL (CONNECTED TO BOOKINGS TABLE) -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-dark"><i class="fas fa-calendar-check text-success me-2"></i> Confirm Venue Booking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Booking" asp-action="CreateBooking" method="post">
                @Html.AntiForgeryToken()
                
                <!-- HIDDEN PARAMETERS MATCHING BOOKINGS TABLE SCHEMAS -->
                <input type="hidden" id="modalItemId" name="itemId" />
                <input type="hidden" id="modalSeatId" name="seatId" value="31" />

                <div class="modal-body px-4">
                    <div class="alert alert-light border rounded-3 p-3 mb-3">
                        <small class="text-muted d-block">Selected Venue / Item:</small>
                        <strong class="text-success fs-6" id="modalVenueName">Venue Name</strong>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Travel / Event Date</label>
                        <input type="date" name="travelOrEventDate" class="form-control rounded-pill px-3 py-2" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Total Amount (BDT)</label>
                        <input type="number" name="totalAmount" class="form-control rounded-pill px-3 py-2" placeholder="e.g. 1000" step="0.01" required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="fas fa-paper-plane me-1"></i> Send Booking Request
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. POST REQUIREMENT MODAL -->
<div class="modal fade" id="createPostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-edit text-success me-2"></i> Post Venue Requirement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Community" asp-action="CreateUserPost" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body px-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Event Title / Purpose</label>
                        <input type="text" asp-for="NewPost.Title" class="form-control rounded-pill px-3 py-2" placeholder="e.g. Corporate Annual Dinner" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small">Guest Capacity</label>
                            <input type="number" asp-for="NewPost.Capacity" class="form-control rounded-pill px-3 py-2" placeholder="e.g. 200" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small">Budget (BDT)</label>
                            <input type="number" asp-for="NewPost.Budget" class="form-control rounded-pill px-3 py-2" placeholder="e.g. 50000" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Preferred Location</label>
                        <input type="text" asp-for="NewPost.Location" class="form-control rounded-pill px-3 py-2" placeholder="e.g. Demra, Dhaka" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Description / Requirements</label>
                        <textarea asp-for="NewPost.Description" class="form-control rounded-3 p-3" rows="3" placeholder="Mention specific requirements..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm"><i class="fas fa-paper-plane me-1"></i> Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JAVASCRIPT TO PASS VENUE ID & NAME TO MODAL -->
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var bookingModal = document.getElementById('bookingModal');
            if (bookingModal) {
                bookingModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var itemId = button.getAttribute('data-itemid');
                    var venueName = button.getAttribute('data-venuename');

                    document.getElementById('modalItemId').value = itemId;
                    document.getElementById('modalVenueName').textContent = venueName;
                });
            }
        });
    </script>
}
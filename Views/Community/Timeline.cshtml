@model EBS.Models.CommunityFeedViewModel

@{
    ViewData["Title"] = "Venue Community Feed";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-2" style="max-width: 700px;">

    <!-- Header -->
    <div class="mb-4 text-center">
        <h3 class="fw-bold text-dark"><i class="fas fa-stream text-primary me-2"></i> Venue Community & Feed</h3>
        <p class="text-muted small">Explore seller venues with seat breakdowns or post your custom requirements!</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Timeline Feed List -->
    <div class="feed-timeline">
        @if (Model.Posts != null && Model.Posts.Any())
        {
            foreach (var post in Model.Posts)
            {
                bool isSellerPost = post.PostType == "SELLER_VENUE";

                <div class="card border-0 shadow-sm mb-4 rounded-3">
                    <!-- Post Header -->
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 45px; height: 45px; font-weight: bold; font-size: 1.1rem;">
                                @post.AuthorName.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@post.AuthorName</h6>
                                <small class="text-muted">
                                    @if (isSellerPost)
                                    {
                                        <span class="badge bg-success">Seller Venue Ad</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Customer Request</span>
                                    }
                                    • @post.CreatedDate.ToString("MMM dd, yyyy - hh:mm tt")
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Post Body -->
                    <div class="card-body px-4 pt-1 pb-3">
                        <h5 class="fw-bold text-dark mb-2">@post.Title</h5>
                        <p class="text-secondary mb-3">@post.Description</p>

                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <div class="row g-2">
                                @if (post.Capacity.HasValue)
                                {
                                    <div class="col-6"><i class="fas fa-users text-info me-1"></i> <strong>Total Capacity:</strong> @post.Capacity.Value Seats</div>
                                }
                                @if (!string.IsNullOrEmpty(post.Location))
                                {
                                    <div class="col-6"><i class="fas fa-map-marker-alt text-danger me-1"></i> <strong>Location:</strong> @post.Location</div>
                                }
                            </div>

                            <!-- SELLER SEAT CATEGORIES (VIP, Regular, Business) -->
                            @if (isSellerPost && post.Categories != null && post.Categories.Any())
                            {
                                <hr class="my-3">
                                <h6 class="fw-bold text-dark mb-2"><i class="fas fa-chair text-success me-1"></i> Available Seat Categories:</h6>
                                <div class="row g-2">
                                    @foreach (var cat in post.Categories)
                                    {
                                        <div class="col-md-4">
                                            <div class="p-2 border bg-white rounded shadow-sm text-center">
                                                <span class="badge bg-dark mb-1">@cat.CategoryName</span>
                                                <div class="small fw-semibold text-muted">@cat.TotalSeats Seats</div>
                                                <div class="small text-success fw-bold">৳@cat.PricePerSeat.ToString("N2") / seat</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Post Footer / Actions -->
                    <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center border-0 rounded-bottom-3">
                        <span class="text-muted small"><i class="fas fa-share-alt me-1"></i> Facebook Style Timeline</span>

                        @if (isSellerPost)
                        {
                            <a href="#" class="btn btn-sm btn-success fw-bold px-3 shadow-sm">
                                <i class="fas fa-check-circle me-1"></i> Confirm & Book Venue
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary fw-bold px-3 shadow-sm">
                                <i class="fas fa-comments me-1"></i> Respond / Offer Venue
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card border-0 shadow-sm text-center py-5 rounded-3">
                <div class="card-body">
                    <i class="fas fa-stream fa-3x text-secondary mb-3"></i>
                    <h5 class="text-muted">No posts on the timeline yet.</h5>
                </div>
            </div>
        }
    </div>
</div>
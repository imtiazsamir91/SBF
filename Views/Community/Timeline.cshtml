@model EBS.Models.CommunityFeedViewModel
@{
    ViewData["Title"] = "Customer Timeline";
    Layout = "~/Views/Shared/_Layout.cshtml"; // বা আপনার কাস্টমার লেআউট
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- 1. FACEBOOK STYLE POST CREATION BOX (TOP SECTION) -->
            <div class="card shadow-sm border-0 mb-4 rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar-circle bg-success text-white fw-bold d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; border-radius: 50%;">
                            <i class="fas fa-user"></i>
                        </div>
                        <button class="btn btn-light rounded-pill w-100 text-start text-muted border px-3 py-2" data-bs-toggle="modal" data-bs-target="#createPostModal">
                            What kind of venue are you looking for? Post your requirements...
                        </button>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-around text-muted small fw-semibold">
                        <span class="btn btn-sm text-secondary" data-bs-toggle="modal" data-bs-target="#createPostModal">
                            <i class="fas fa-building text-primary me-1"></i> Venue Type
                        </span>
                        <span class="btn btn-sm text-secondary" data-bs-toggle="modal" data-bs-target="#createPostModal">
                            <i class="fas fa-users text-success me-1"></i> Guest Capacity
                        </span>
                        <span class="btn btn-sm text-secondary" data-bs-toggle="modal" data-bs-target="#createPostModal">
                            <i class="fas fa-wallet text-warning me-1"></i> Budget
                        </span>
                    </div>
                </div>
            </div>

            <!-- SUCCESS MESSAGE ALERT -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- 2. COMMUNITY TIMELINE FEED (SELLER VENUES & POSTS) -->
            <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-stream text-success me-2"></i> Explore Venues & Offers</h5>

            @if (Model.Posts != null && Model.Posts.Count > 0)
            {
                foreach (var post in Model.Posts)
                {
                    <div class="card shadow-sm border-0 mb-4 rounded-3">
                        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-3 px-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="fas fa-store"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">@post.Title</h6>
                                    <small class="text-muted">Managed by <strong>@post.AuthorName</strong> • <i class="fas fa-map-marker-alt text-danger me-1"></i>@post.Location</small>
                                </div>
                            </div>
                            <span class="badge bg-success px-3 py-2">@post.PostType</span>
                        </div>
                        <div class="card-body px-3 py-2">
                            <p class="card-text text-secondary">@post.Description</p>
                            
                            @if (post.Capacity.HasValue && post.Capacity > 0)
                            {
                                <div class="mb-2">
                                    <span class="badge bg-light text-dark border"><i class="fas fa-chair text-primary me-1"></i> Capacity: @post.Capacity Seats</span>
                                </div>
                            }

                            <!-- SEAT CATEGORY BREAKDOWN TABLE -->
                            @if (post.Categories != null && post.Categories.Count > 0)
                            {
                                <div class="mt-3 bg-light p-3 rounded-3">
                                    <h6 class="fw-bold text-dark mb-2"><i class="fas fa-layer-group text-success me-1"></i> Seat Category Breakdown</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered bg-white mb-0">
                                            <thead class="table-secondary">
                                                <tr>
                                                    <th>Category</th>
                                                    <th>Seats</th>
                                                    <th>Price / Seat</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var cat in post.Categories)
                                                {
                                                    <tr>
                                                        <td><strong>@cat.CategoryName</strong></td>
                                                        <td>@cat.TotalSeats</td>
                                                        <td class="text-success fw-bold">৳@cat.PricePerSeat</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center pb-3 px-3">
                            <small class="text-muted"><i class="far fa-clock me-1"></i>@post.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</small>
                            <a asp-controller="Booking" asp-action="VenueDetails" asp-route-id="@post.PostId" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                <i class="fas fa-ticket-alt me-1"></i> Book Seats / Venue
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-3 shadow-sm">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted fs-6">No venue posts available on the timeline yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- 3. POST CREATION MODAL FORM -->
<div class="modal fade" id="createPostModal" tabindex="-1" aria-labelledby="createPostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createPostModalLabel"><i class="fas fa-edit text-success me-2"></i> Post Venue Requirement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Community" asp-action="CreateUserPost" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Event Title / Purpose</label>
                        <input type="text" asp-for="NewPost.Title" class="form-control" placeholder="e.g. Wedding Reception, Birthday Party" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Required Capacity (Guests)</label>
                            <input type="number" asp-for="NewPost.Capacity" class="form-control" placeholder="e.g. 200" min="1" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Budget (BDT)</label>
                            <input type="number" asp-for="NewPost.Budget" class="form-control" placeholder="e.g. 50000" step="500" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Preferred Location</label>
                        <input type="text" asp-for="NewPost.Location" class="form-control" placeholder="e.g. Mirpur, Uttara, Demra" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Additional Details / Requirements</label>
                        <textarea asp-for="NewPost.Description" class="form-control" rows="3" placeholder="Mention special requirements like catering, AC, parking..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4"><i class="fas fa-paper-plane me-1"></i> Publish Post</button>
                </div>
            </form>
        </div>
    </div>
</div>
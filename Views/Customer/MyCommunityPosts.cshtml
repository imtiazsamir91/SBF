@model IEnumerable<EBS.Models.PostItem>

@{
    ViewData["Title"] = "My Community Posts";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-user-edit text-primary me-2"></i> My Community Posts</h2>
            <p class="text-muted mb-0">View and manage your venue booking requirements.</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var post in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-info text-dark">Request ID: #@post.PostId</span>
                                <small class="text-muted"><i class="far fa-clock me-1"></i>@post.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</small>
                            </div>
                            <h5 class="fw-bold text-dark">@post.Title</h5>
                            <p class="text-muted mb-2">@post.Description</p>

                            <div class="d-flex flex-wrap gap-2 mt-3 small">
                                @if (post.Budget.HasValue)
                                {
                                    <span class="badge bg-success"><i class="fas fa-money-bill-wave me-1"></i>Budget: ৳@post.Budget.Value.ToString("N2")</span>
                                }
                                @if (post.Capacity.HasValue)
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-users me-1"></i>@post.Capacity.Value Seats</span>
                                }
                                @if (!string.IsNullOrEmpty(post.Location))
                                {
                                    <span class="badge bg-dark"><i class="fas fa-map-marker-alt me-1"></i>@post.Location</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-folder-open fa-3x text-secondary mb-3 d-block"></i>
                <h5 class="fw-bold">You haven't posted any requirements yet.</h5>
            </div>
        }
    </div>
</div>
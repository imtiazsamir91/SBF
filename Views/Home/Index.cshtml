@{
    ViewData["Title"] = "Welcome to Venue Booking System";
}

<div class="container py-5">
    <!-- Hero Section -->
    <div class="row align-items-center justify-content-center min-vh-75 py-5">
        <div class="col-lg-8 text-center">
            <div class="mb-4">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold mb-3">
                    <i class="fas fa-calendar-check me-2"></i> Smart Venue & Seating Management
                </span>
                <h1 class="display-3 fw-bold text-dark mb-3">
                    Find & Book Your <span class="text-primary">Perfect Venue</span> Effortlessly
                </h1>
                <p class="lead text-muted mb-4 px-md-5">
                    Connect directly with top-tier convention halls, manage your booking requests in real-time, and explore community posts tailored to your event requirements.
                </p>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-lg px-5 py-3 fw-semibold shadow-sm rounded-pill">
                    <i class="fas fa-sign-in-alt me-2"></i> Get Started / Login
                </a>
                <a href="#features" class="btn btn-outline-secondary btn-lg px-4 py-3 fw-semibold rounded-pill">
                    <i class="fas fa-info-circle me-2"></i> Learn More
                </a>
            </div>
        </div>
    </div>

    <!-- Features Section / Cards -->
    <div class="row g-4 py-5 mt-4" id="features">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 bg-white text-center">
                <div class="card-body">
                    <div class="mb-3 text-primary bg-primary bg-opacity-15 d-inline-flex p-3 rounded-circle">
                        <i class="fas fa-building fa-2x"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Verified Venues</h5>
                    <p class="text-muted small mb-0">
                        Explore premium halls with custom seating categories like VIP, Regular, and Business class.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 bg-white text-center">
                <div class="card-body">
                    <div class="mb-3 text-success bg-success bg-opacity-15 d-inline-flex p-3 rounded-circle">
                        <i class="fas fa-comments fa-2x"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Community Feed</h5>
                    <p class="text-muted small mb-0">
                        Post your event requirements and let sellers connect with you directly with custom proposals.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 bg-white text-center">
                <div class="card-body">
                    <div class="mb-3 text-info bg-info bg-opacity-15 d-inline-flex p-3 rounded-circle">
                        <i class="fas fa-shield-alt fa-2x"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Smart Management</h5>
                    <p class="text-muted small mb-0">
                        Seamlessly track active requests, check expiration dates, and manage your bookings in one place.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Note -->
    <div class="row text-center mt-5 pt-4 border-top">
        <div class="col-12">
            <p class="text-muted small mb-0">
                &copy; @DateTime.Now.Year - Event & Venue Booking System (EBS). All rights reserved.
            </p>
        </div>
    </div>
</div>

<style>
    .min-vh-75 {
        min-height: 60vh;
    }
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.08)!important;
    }
</style>
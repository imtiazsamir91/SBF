@model IEnumerable<EBS.Models.PostItem>

@{
    ViewData["Title"] = "Seller Community Feed";
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
}

<div class="container my-4">
    <h3 class="mb-4"><i class="fas fa-stream me-2"></i> Customer Venue Requirements Feed</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                <div class="col-md-12 mb-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@post.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">
                                By: @post.AuthorName | Location: @post.Location | Capacity: @post.Capacity Seats
                            </h6>
                            <p class="card-text">@post.Description</p>

                            <div class="mb-3 text-success fw-bold">
                                Budget: ৳@(post.Budget?.ToString("N0") ?? "Negotiable")
                            </div>

                           
                            <form asp-controller="Seller" asp-action="SubmitPostResponse" method="post" class="mt-3 p-3 bg-light rounded border">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.PostId" />

                                <div class="mb-2">
                                    <label class="form-label fw-semibold small">Your Proposal / Message</label>
                                    <textarea name="proposalMessage" class="form-control form-control-sm" rows="2" placeholder="Write your venue offer details..." required></textarea>
                                </div>

                                <div class="row align-items-center">
                                    <div class="col-md-4 mb-2 mb-md-0">
                                        <label class="form-label fw-semibold small">Offer Price (৳)</label>
                                        <input type="number" name="offerPrice" class="form-control form-control-sm" placeholder="Enter amount" required />
                                    </div>
                                    <div class="col-md-8 text-md-end">
                                        <button type="submit" class="btn btn-primary btn-sm px-4">
                                            <i class="fas fa-paper-plane me-1"></i> Send Response
                                        </button>
                                    </div>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center">No customer requirements posted yet.</div>
            </div>
        }
    </div>
</div>
@model IEnumerable<EBS.Models.PostItem>

@{
    ViewData["Title"] = "Seller Community Feed";
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header Banner -->
    <div class="card bg-white border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold text-dark mb-1"><i class="fas fa-stream text-success me-2"></i> Customer Venue Requirements Feed</h3>
                <p class="text-muted mb-0">Browse requirements posted by customers and submit your custom proposals.</p>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Posts List -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge bg-primary mb-2">@post.PostType</span>
                                    <h4 class="fw-bold text-dark mb-1">@post.Title</h4>
                                    <small class="text-muted">Posted by <strong>@post.AuthorName</strong> on @post.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</small>
                                </div>
                            </div>

                            <p class="text-muted mt-3 mb-3">@post.Description</p>

                            <div class="d-flex gap-4 text-secondary small bg-light p-3 rounded-3 mb-4">
                                <div><i class="fas fa-coins text-warning me-1"></i> <strong>Budget:</strong> @(post.Budget.HasValue? post.Budget.Value.ToString("N0") + " ৳" : "Negotiable")</div>
                                <div><i class="fas fa-users text-info me-1"></i> <strong>Capacity:</strong> @(post.Capacity.HasValue? post.Capacity.Value.ToString() : "N/A") Seats</div>
                                <div><i class="fas fa-map-marker-alt text-danger me-1"></i> <strong>Location:</strong> @post.Location</div>
                            </div>

                            <!-- Submit Response Form for Seller -->
                            <div class="card border border-success-subtle bg-light rounded-3 p-3">
                                <h6 class="fw-bold text-success mb-3"><i class="fas fa-paper-plane me-1"></i> Submit Your Proposal / Offer</h6>

                                <form asp-controller="Seller" asp-action="SubmitPostResponse" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@post.PostId" />

                                    <div class="row g-3">
                                        <div class="col-md-8">
                                            <label class="form-label small fw-semibold">Proposal Message / Details</label>
                                            <textarea name="proposalMessage" class="form-control form-control-sm" rows="2" placeholder="Write your offer details, amenities, or discounts..." required></textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Offer Price (৳)</label>
                                            <div class="input-group input-group-sm mb-2">
                                                <span class="input-group-text">৳</span>
                                                <input type="number" name="offerPrice" class="form-control" placeholder="Enter amount" required />
                                            </div>
                                            <button type="submit" class="btn btn-success btn-sm w-100 fw-semibold">
                                                <i class="fas fa-paper-plane me-1"></i> Send Proposal
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm p-5 text-center rounded-4">
                    <i class="fas fa-folder-open fa-3x text-secondary mb-3"></i>
                    <p class="text-muted mb-0">No customer requirements available in the community feed right now.</p>
                </div>
            </div>
        }
    </div>
</div>
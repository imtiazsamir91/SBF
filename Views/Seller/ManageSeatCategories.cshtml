@model EBS.Models.SeatCategoryManagementViewModel

@{
    ViewData["Title"] = "Manage Seat Categories";
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <!-- Top Header & Action Buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-chair text-success me-2"></i> Seat Categories & Allocation</h2>
            <p class="text-muted mb-0">Define category-wise seats (VIP, Regular, Business) within your venue capacity.</p>
        </div>
        <div class="d-flex gap-2">
            <!-- Scroll to / View Table Button -->
            <a href="#configuredCategoriesSection" class="btn btn-dark btn-sm fw-bold shadow-sm px-3">
                <i class="fas fa-list me-1"></i> View Configured Categories (@Model.ExistingCategories.Count())
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Capacity Info Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white p-3">
                <div class="text-white-50 small fw-bold">TOTAL VENUE CAPACITY</div>
                <h2 class="fw-bold mb-0 mt-1">@Model.TotalCapacitySeats</h2>
                <small>From dynamic floor sections</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white p-3">
                <div class="text-white-50 small fw-bold">TOTAL ALLOCATED SEATS</div>
                <h2 class="fw-bold mb-0 mt-1">@Model.AllocatedSeatsCount</h2>
                <small>Assigned across categories</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-warning text-dark p-3">
                <div class="text-dark small fw-bold">REMAINING UNASSIGNED SEATS</div>
                <h2 class="fw-bold mb-0 mt-1">@Model.RemainingSeats</h2>
                <small>Available to allocate</small>
            </div>
        </div>
    </div>

    <!-- MAIN PAGE: ALLOCATION & BOOKING RULE FORMS -->
    <div class="row g-4 mb-5">
        <!-- Full Venue Booking Rule Setting Form -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="fw-bold m-0"><i class="fas fa-sliders-h me-2"></i> Booking Rule Setting</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="UpdateVenueBookingRule" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sellerCatId" value="@Model.SellerCatId" />

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="allowFullVenue" name="allowFullVenue" value="true" @(Model.AllowFullVenue == 1 ? "checked" : "") style="width: 45px; height: 22px;">
                            <label class="form-check-label fw-semibold text-dark ms-2" for="allowFullVenue">
                                Allow Full Venue Reservation Only
                            </label>
                        </div>
                        <small class="text-muted d-block mb-3">
                            <i class="fas fa-info-circle text-primary me-1"></i> When ON, customers must reserve the entire venue. When OFF, customers can book individual seats (max 6 seats per request).
                        </small>
                        <button type="submit" class="btn btn-dark w-100 btn-sm fw-bold shadow-sm py-2">
                            <i class="fas fa-save me-1"></i> Save Booking Rule
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Allocate Seat Category Form -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="fw-bold m-0"><i class="fas fa-plus-circle me-2"></i> Allocate Seat Category</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="SaveSeatCategory" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sellerCatId" value="@Model.SellerCatId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Category Name *</label>
                            <input type="text" name="categoryName" class="form-control" placeholder="e.g. VIP, Regular, Business" required />
                            <div class="form-text small">Default category is 'Regular'.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Price Per Seat (৳) *</label>
                            <input type="number" step="0.01" min="1" name="pricePerSeat" class="form-control" placeholder="e.g. 500" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Number of Seats *</label>
                            <input type="number" name="totalSeats" class="form-control"
                                   min="1" max="@Model.RemainingSeats"
                                   placeholder="Max remaining: @Model.RemainingSeats"
                                   @(Model.RemainingSeats <= 0 ? "disabled" : "") required />
                            <div class="form-text text-muted small">
                                @if (Model.RemainingSeats > 0)
                                {
                                    <span class="text-success fw-bold"><i class="fas fa-info-circle me-1"></i> You can allocate up to @Model.RemainingSeats seats.</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold"><i class="fas fa-exclamation-circle me-1"></i> All venue capacity seats have been fully allocated!</span>
                                }
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 fw-bold shadow-sm py-2" @(Model.RemainingSeats <= 0 ? "disabled" : "")>
                            <i class="fas fa-save me-1"></i> Save & Allocate Seats
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= SAME PAGE: CONFIGURD CATEGORIES & SEAT NUMBERS TABLE SECTION ================= -->
    <div class="row" id="configuredCategoriesSection">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold m-0"><i class="fas fa-list me-2"></i> Configured Categories & Seat Numbers</h5>
                    <span class="badge bg-light text-dark px-3 py-2">Total Categories: @Model.ExistingCategories.Count()</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Category</th>
                                    <th>Price</th>
                                    <th>Seats & Range</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ExistingCategories.Any())
                                {
                                    int runningSeatCounter = 1;
                                    foreach (var cat in Model.ExistingCategories)
                                    {
                                        int startNum = runningSeatCounter;
                                        int endNum = runningSeatCounter + cat.TotalSeats - 1;
                                        runningSeatCounter = endNum + 1;

                                        string seatRangeDisplay = $"A2{startNum.ToString("D4")} - A2{endNum.ToString("D4")}";

                                        <tr>
                                            <td class="fw-bold text-dark ps-4">
                                                <i class="fas fa-tag text-success me-2"></i>@cat.CategoryName
                                            </td>
                                            <td class="text-success fw-bold">৳@cat.PricePerSeat.ToString("N2")</td>
                                            <td>
                                                <span class="badge bg-info text-dark px-2 py-1">@cat.TotalSeats Seats</span>
                                                <div class="small text-muted mt-1"><i class="fas fa-barcode me-1"></i> @seatRangeDisplay</div>
                                            </td>
                                            <td class="text-end pe-4">
                                                <!-- Edit Button -->
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                                        onclick="openEditModal(@cat.SeatCatId, '@cat.CategoryName', @cat.PricePerSeat, @cat.TotalSeats)">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>

                                                <!-- Delete Button Form -->
                                                <form asp-action="DeleteSeatCategory" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this seat category?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="seatCatId" value="@cat.SeatCatId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="fas fa-chair fa-3x mb-3 d-block text-secondary"></i>
                                            <h5>No seat categories allocated yet.</h5>
                                            <p class="small">Use the allocation form above to create categories.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="editCategoryModalLabel"><i class="fas fa-edit me-2"></i> Update Seat Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateSeatCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" id="editSeatCatId" name="seatCatId" />
                    <input type="hidden" name="sellerCatId" value="@Model.SellerCatId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Category Name *</label>
                        <input type="text" id="editCategoryName" name="categoryName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Price Per Seat (৳) *</label>
                        <input type="number" step="0.01" min="1" id="editPricePerSeat" name="pricePerSeat" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Number of Seats *</label>
                        <input type="number" min="1" id="editTotalSeats" name="totalSeats" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold"><i class="fas fa-check me-1"></i> Update Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Edit Modal Script
        function openEditModal(id, name, price, seats) {
            document.getElementById('editSeatCatId').value = id;
            document.getElementById('editCategoryName').value = name;
            document.getElementById('editPricePerSeat').value = price;
            document.getElementById('editTotalSeats').value = seats;

            var editModal = new bootstrap.Modal(document.getElementById('editCategoryModal'));
            editModal.show();
        }
    </script>
}
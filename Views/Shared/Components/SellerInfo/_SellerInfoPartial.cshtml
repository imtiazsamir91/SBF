@model dynamic

<div class="d-flex align-items-center gap-3">
    <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">
        <i class="fas fa-user-check me-1"></i> @ViewData["SellerName"]
    </span>
    <span class="badge bg-dark px-3 py-2 fs-6 shadow-sm text-light">
        <i class="fas fa-store me-1"></i> @ViewData["ItemName"]
    </span>
</div>
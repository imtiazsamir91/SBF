<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EBS Customer Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #f0f2f5; /* Facebook style background */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden; /* পুরো পেজের বডি স্ক্রোল বন্ধ রাখা */
        }

        .navbar-brand {
            font-weight: bold;
            letter-spacing: 0.5px;
        }
        /* ফিক্সড সাইডবার এবং মেইন কন্টেন্ট লেআউট */
        .wrapper {
            display: flex;
            height: calc(100vh - 56px); /* টপ নেভবার বাদ দিয়ে বাকি উচ্চতা */
        }

        .sidebar {
            width: 260px;
            background: #ffffff;
            border-right: 1px solid #dee2e6;
            overflow-y: auto; /* সাইডবারে নিজস্ব স্ক্রোল চাইলে */
            flex-shrink: 0;
        }

            .sidebar .nav-link {
                color: #333;
                font-weight: 500;
                padding: 10px 20px;
                margin-bottom: 5px;
                border-radius: 6px;
                transition: all 0.2s ease-in-out;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background-color: #e7f3ff;
                    color: #0d6efd;
                }
        /* কেবল এই মেইন কন্টেন্ট এরিয়াটিই ফেসবুকের মতো স্ক্রোল হবে */
        .main-content-scrollable {
            flex-grow: 1;
            height: 100%;
            overflow-y: auto;
            background-color: #f0f2f5;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- Top Navbar (Fixed) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm" style="height: 56px;">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="#"><i class="fas fa-hotel me-2 text-success"></i>EBS Customer Panel</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-user-circle me-1"></i> Imtiaz Samir
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2 text-muted"></i> Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="fas fa-sign-out-alt me-2"></i> Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Wrapper Layout -->
    <div class="wrapper">
        <!-- Fixed Sidebar -->
        <nav id="sidebar" class="sidebar p-3 d-none d-md-block">
            <h6 class="sidebar-heading text-muted text-uppercase fs-7 fw-bold px-3 mb-2">Customer Menu</h6>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Customer" asp-action="MyVenueRequests">
                        <i class="fas fa-building me-2"></i> My Requests
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Community" asp-action="Timeline">
                        <i class="fas fa-stream me-2"></i> Community Feed
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="fas fa-calendar-check me-2"></i> My Bookings
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="fas fa-wallet me-2"></i> Payments
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Scrollable Main Feed Area -->
        <main class="main-content-scrollable p-4">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>